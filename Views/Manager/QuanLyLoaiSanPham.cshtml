@model IEnumerable<Vinfast.Models.LoaiSanPham>

@{
    ViewBag.Title = "Manager";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row m-auto mt-3">
        <div class="col-lg-7 col-md-12">

            <div class="card shadow p-4" style="border-radius: 8px;">
                <h4 style="text-align: center;">Danh sách các loại sản phẩm</h4>
                <table class="table">
                    <tr>
                        <th>
                            @*@Html.DisplayNameFor(model => model.MaLoaiSP)*@
                            <p><strong>Mã loại</strong></p>
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.TenLoai)*@
                            <p><strong>Tên loại</strong></p>

                        </th>
                        <th></th>
                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.MaLoaiSP)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TenLoai)
                            </td>
                            <td>
                                @Html.ActionLink("Xóa", "Delete_LoaiSP_Action", "Manager", new { maloai = item.MaLoaiSP },new{@class = "btn btn-danger btn-sm",onclick = "return confirm('Bạn có chắc chắn muốn xóa loại sản phẩm này không?')"})
                            </td>
                        </tr>
                    }

                </table>
            </div>

        </div>
        <div class="col-lg-5 col-md-12">
            @Html.Action("_ThemLoaiSP", "Manager")

            @using (Html.BeginForm("SuaLoaiSanPham_Action", "Manager"))
            {
                <div class="card shadow p-4" style="border-radius: 8px;">
                    <h4 style="text-align: center">Chỉnh sửa loại sản phẩm</h4>
                    <div>
                        <p><strong>Mã loại cần thay đổi</strong></p>
                        <input type="number" name="maloai" class="form-control" />
                    </div>
                    <div>
                        <p><strong>Tên loại mới cần thay đổi</strong></p>
                        <input type="text" name="tenloaimoi" class="form-control" />
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary"  style="width: 75%;">Lưu thay đổi</button>
                        <a href="@Url.Action("Huy_ActionSP", "Manager")"  class="btn btn-warning" style="width: 23%;">Hủy</a>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

