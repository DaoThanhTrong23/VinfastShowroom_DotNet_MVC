@model IEnumerable<Vinfast.Models.DSSanPham_Anh>

@{
    ViewBag.Title = "Dòng xe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    .card-img-top {
        height: 200px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .btn-dark {
        background-color: #222;
        border: none;
    }

        .btn-dark:hover {
            background-color: #000;
        }

    .card-title {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .card-text {
        font-size: 0.9rem;
    }
</style>

<div class="container my-4">
    <h2 class="mb-4 text-center"><strong>Danh sách sản phẩm</strong></h2>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-lg">
                    <img src="~/Content/Images/@item.AvatarDuongDan" class="card-img-top" alt="@item.TenSP">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.TenSP</h5>
                        <p class="card-text mb-1"><strong>Giá:</strong> @String.Format("{0:N0} đ", item.Gia)</p>
                        <p class="card-text mb-1"><strong>Màu sắc:</strong> @item.MauSac</p>
                        <div class="mt-auto">
                            @*@Html.ActionLink("Chi tiết", "Details", new { id = item.MaSP }, new { @class = "btn btn-dark w-100" })*@
                            <a href="@Url.Action("LayChiTietSP_Action", "SanPham", new {masp = item.MaSP})" class="btn btn-dark w-100" >Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>