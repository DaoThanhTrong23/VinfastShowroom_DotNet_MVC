@model IEnumerable<Vinfast.Models.Voucher>

@{
    ViewBag.Title = "Khuyến mãi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 1. Thiết lập Nền chung (Giả định Layout đã có nền tối) */
    body {
        background-color: #0d0d0d; /* Đảm bảo nền tối */
        color: #f8f9fa;
    }

    /* 2. Style cho Card Voucher */
    .card-voucher {
        background-color: #1a1a1a; /* Nền card đậm hơn một chút */
        color: #f8f9fa;
        border: 1px solid #333; /* Viền nhẹ */
        transition: all 0.3s ease;
        position: relative; /* Để sử dụng pseudo-elements cho hiệu ứng cắt */
    }

        .card-voucher:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.7); /* Shadow mạnh hơn khi hover */
            border-color: #007bff; /* Thay đổi viền khi hover */
        }

    /* 3. Hiệu ứng "Giảm giá" nổi bật (Sử dụng màu Vinfast/Primary) */
    .discount-badge {
        background: linear-gradient(45deg, #007bff, #0056b3);
        color: white;
        font-size: 1.2rem;
        font-weight: bold;
        padding: 5px 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    /* 4. Hiệu ứng cắt (Optional: Thêm dấu gạch ngang mô phỏng voucher giấy) */
    .card-footer-cut::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: repeating-linear-gradient(-45deg, transparent, transparent 5px, #333 5px, #333 10px);
        opacity: 0.5;
    }

    /* 5. Nút Hành động */
    .btn-action {
        background-color: #007bff; /* Primary color */
        color: white;
        border: 1px solid #007bff;
    }

        .btn-action:hover {
            background-color: #0056b3;
            color: #ffc107; /* Thêm chút màu vàng nổi bật khi hover */
            border-color: #ffc107;
        }
</style>

<div class="container my-5">
    <h2 class="mb-5 text-center text-primary border-bottom pb-3">ƯU ĐÃI VÀ KHUYẾN MÃI ĐỘC QUYỀN</h2>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card card-voucher h-100 shadow-lg">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-title text-warning mb-0">CODE:</h6>
                            <span class="discount-badge">
                                @String.Format("{0:N0} %", item.GiamGia) OFF
                            </span>
                        </div>
                        <h4 class="fw-bold mb-3 text-primary border-bottom pb-2">@item.MaVoucher</h4>

                        <p class="card-text text-light small flex-grow-1">
                            **Áp dụng:** @item.GhiChu
                        </p>

                        <div class="mt-3 small">
                            <p class="mb-1 text-success">
                                <i class="bi bi-clock"></i> Ngày tạo: @item.NgayTao.ToString("dd/MM/yyyy")
                            </p>
                            <p class="mb-2 text-danger fw-bold">
                                <i class="bi bi-calendar-x"></i> Hạn cuối: @item.NgayHetHan.ToString("dd/MM/yyyy")
                            </p>
                        </div>

                    </div>

                    <div class="card-footer card-footer-cut bg-transparent border-0 pt-3">
                        <button class="btn btn-action w-100 btn-sm copy-btn" data-code="@item.MaVoucher">
                            <i class="bi bi-clipboard"></i> COPY MÃ CODE
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


@section scripts {
    <script>
        $(document).ready(function () {
            $('.copy-btn').on('click', function() {
                var code = $(this).data('code');
                var button = $(this);

                navigator.clipboard.writeText(code).then(function() {

                    var originalText = button.html();
                    var originalClass = button.attr('class');

                    button.html('<i class="bi bi-check-lg"></i> ĐÃ SAO CHÉP');
                    button.removeClass().addClass('btn btn-success w-100 btn-sm');

                    setTimeout(function() {
                        button.html(originalText);
                        button.removeClass().addClass(originalClass);
                    }, 2000);

                }).catch(err => {
                    alert('Lỗi sao chép mã code: ' + err);
                    console.error('Lỗi khi sao chép: ', err);
                });
            });
        });
    </script>
}