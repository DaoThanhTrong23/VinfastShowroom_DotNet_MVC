
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg border-0" style="width: 400px; border-radius: 15px;background-color: rgb(255, 255, 255, 1)">
        <div class="card-body p-4">
            <div class="text-start mb-4">
                <img src="~/Content/Images/logo-1.png" alt="VinFast Logo" style="height:30px;">
                
            </div>
            <div class="text-center mb-4">
                <h4 class="mt-3 fw-bold text-dark">Đăng nhập</h4>
                <p class="text-muted small">Chào mừng bạn đến với Showroom VinFast</p>
            </div>

            @using (Html.BeginForm("DangNhapAction", "Account", FormMethod.Post))
            {
                <div class="form-group mb-3">
                    <label for="username" class="form-label fw-semibold">Tài khoản</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white"><i class="bi bi-person-fill"></i></span>
                        <input type="text" class="form-control" id="username" name="username" required placeholder="Nhập tài khoản" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="password" class="form-label fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white"><i class="bi bi-lock-fill"></i></span>
                        <input type="password" class="form-control" id="password" name="password" required placeholder="Nhập mật khẩu" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="border-radius: 10px;">
                    Đăng nhập
                </button>

                <div class="text-center mt-3">
                    <br />
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a href="~/Account/DangKy" class="fw-semibold text-primary text-decoration-none">Đăng ký ngay</a>
                </div>
            }
        </div>
    </div>
</div>
