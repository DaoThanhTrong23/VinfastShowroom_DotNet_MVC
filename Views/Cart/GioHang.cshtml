@model IEnumerable<Vinfast.Models.ChiTietGioHang>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    table.table-hover tbody tr:hover {
        background-color: #f7faff;
        transition: 0.2s ease;
    }

    @@media (max-width: 768px) {
        table thead {
            display: none;
        }

        table, tbody, tr, td {
            display: block;
            width: 100%;
        }

        tr {
            background: #fff;
            margin-bottom: 15px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        td {
            padding-left: 50%;
            text-align: right;
            position: relative;
        }

        td::before {
            content: attr(data-label);
            position: absolute;
            left: 15px;
            font-weight: bold;
            color: #333;
        }
    }
</style>

<div class="container py-4">
    <h2 class="mb-4 fw-bold text-primary">Giỏ Hàng Của Bạn</h2>

    <p>
        <a class="btn btn-success" href="~/Home/DongXe">Tiếp tục mua sắm</a>
    </p>

    <div class="row g-4">
        <div class="col-lg-7 col-md-12">
            <div class="table-responsive">
                <table class="table table-striped table-hover text-center align-middle shadow-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Tên SP">@item.TenSP</td>
                                <td data-label="Giá bán">@String.Format("{0:N0}₫", item.Gia)</td>
                                <td data-label="Số lượng" class="d-flex justify-content-center align-items-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="@Url.Action("GiamSoLuongSP", "Cart", new { masp = item.MaSP })" class="btn btn-warning px-3">−</a>
                                        <span class="fw-bold">@item.SoLuong</span>
                                        <a href="@Url.Action("TangSoLuongSP", "Cart", new { masp = item.MaSP })" class="btn btn-success px-3">+</a>
                                    </div>
                                </td>
                                <td data-label="Thành tiền">@String.Format("{0:N0}₫", item.ThanhTien)</td>
                                <td data-label="Xóa">
                                    @Html.ActionLink("Xóa", "Delete", new { id = item.MaSP }, new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-3">
                    Giỏ hàng của bạn đang trống.
                </div>
            }
        </div>

        <div class="col-lg-5 col-md-12">
            <div class="card p-4 shadow-lg">
                <h3 class="text-center fw-bold text-primary">Hóa Đơn</h3>

                <div class="mt-3">
                    <h5 class="fw-bold">Tổng hóa đơn:</h5>
                    <span class="text-success fs-3 fw-bold">
                        @String.Format("{0:N0}₫", ViewBag.TongThanhToan ?? 0)
                    </span>
                </div>

                <hr />

                @using (Html.BeginForm("ApDungVoucher", "Cart", FormMethod.Post))
                {
                    <h5 class="fw-bold mt-3">Mã giảm giá</h5>
                    <div class="d-flex justify-content-between">
                        <input type="text" name="MaVoucher" placeholder="Nhập mã giảm giá" value="@(TempData["mavc"]??"")" class="form-control w-75" />
                        <button type="submit" class="btn btn-success" style="width: 20%">Áp dụng</button>
                    </div>
                }

            <div class="mt-3">
                <label>Phần trăm giảm:</label>
                <h5 class="text-primary">
                    @(TempData["GiamGia"] != null ? TempData["GiamGia"].ToString() : "0") %
                </h5>
            </div>

                <hr />

                @using (Html.BeginForm("ThanhToan", "Cart", FormMethod.Post))
                {
                    <input type="hidden" name="MaVoucher" value="@(TempData["mavc"]??"")" />

                    {
                        decimal tong = ViewBag.TongThanhToan ?? 0;
                        int giam = TempData["GiamGia"] != null ? Convert.ToInt32(TempData["GiamGia"]) : 0;
                        decimal tongSauGiam = tong - (tong * giam / 100);
                        <h4>Tổng thành tiền: @String.Format("{0:N0}₫", tongSauGiam)</h4>

                    }

                    <button type="submit" class="btn btn-primary w-100 mt-3 btn-lg">Thanh toán</button>
                }
            </div>
        </div>
    </div>
</div>
<h3 style="text-align: center;">----- Lịch sử mua hàng -----</h3>
<div class="container">
    @Html.Action("_DanhSachHoaDon", "Cart")
</div>